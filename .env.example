# Configuración MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=relay_bot
DB_CONNECTION_LIMIT=5

# Configuración Discord
DISCORD_BOT_TOKEN=tu_token_de_bot_aqui
DISCORD_GUILD_ID=tu_id_de_servidor_de_discord_aqui
DISCORD_WEBHOOK_CACHE_TTL=300000

# Configuración WhatsApp (Opcional si usas pairing code en vez de QR)
PAIRING_NUMBER=
# Estado de presencia inicial: online (por defecto) u offline
WA_PRESENCE=online

# Configuración Relay
RELAY_MESSAGE_RETENTION_HOURS=24
RELAY_CLEANUP_INTERVAL_MS=3600000
