# Configuración MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=relay_bot
DB_CONNECTION_LIMIT=5

# Configuración Discord
DISCORD_BOT_TOKEN=tu_token_de_bot_aqui
DISCORD_GUILD_ID=tu_id_de_servidor_de_discord_aqui
# Otros servidores (p. ej. el público) donde también funcionan la música y /minecraft, separados por coma.
# Tickets y /espejo siguen solo en DISCORD_GUILD_ID.
DISCORD_EXTRA_GUILD_IDS=
DISCORD_WEBHOOK_CACHE_TTL=300000

# Configuración WhatsApp (Opcional si usas pairing code en vez de QR)
PAIRING_NUMBER=
# Estado de presencia inicial: online (por defecto) u offline
WA_PRESENCE=online

# Configuración Relay
RELAY_ENABLED=true
RELAY_MESSAGE_RETENTION_HOURS=24
RELAY_CLEANUP_INTERVAL_MS=3600000
# Sincronización de mensajes perdidos cuando el bot estuvo desconectado
RELAY_SYNC_MISSED=true
RELAY_MAX_MISSED_HOURS=24
# Modo del embed para fecha/hora: 'missed' (solo mensajes recuperados), 'all' o 'none'
RELAY_EMBED_TIMESTAMP=missed
# Opt-in: reenviar también mensajes enviados desde el celular / otra sesión
RELAY_OWN_MESSAGES=false
# Notificaciones de entrada y salida de miembros en grupos de WhatsApp hacia Discord (embed)
RELAY_GROUP_EVENTS=true

# Tickets: los privados se atienden como soporte; los grupos conservan su relay.
TICKETS_ENABLED=true
# Categoría opcional. Los canales se crean con permisos privados explícitos.
TICKETS_CATEGORY_ID=
# IDs separados por coma. Manage Server también autoriza comandos de soporte.
TICKETS_STAFF_ROLE_IDS=
TICKETS_POLL_INTERVAL_MS=15000
# Vacíos = tickets locales. Ambos definidos = web como fuente de verdad.
IMPECRAFT_WEB_URL=
# Mismo secreto de al menos 32 caracteres en la web. No usar el token de Discord.
IMPECRAFT_BOT_TOKEN=

# Música en canales de voz de Discord (/play, /skip, /stop, /pause, /resume, /cola, /volumen)
MUSIC_ENABLED=true
MUSIC_DEFAULT_VOLUME=50
MUSIC_MAX_MINUTES=60
MUSIC_MAX_QUEUE=50
# Segundos que espera en el canal al acabar la cola (0 = sale en cuanto termina)
MUSIC_IDLE_LEAVE_SECONDS=0
# Segundos que espera si el canal de voz se queda sin personas (0 = sale al momento)
MUSIC_EMPTY_LEAVE_SECONDS=0

# Moderación de grupos de WhatsApp (!borrar, !ban, !desban, !bans)
# Números o LIDs con permiso en TODOS los grupos, separados por coma (ej. 56912345678,25349484220559)
WA_STAFF_IDS=
# Los administradores del grupo también pueden moderar
WA_MOD_GROUP_ADMINS=true
# Expulsar de nuevo a un baneado que vuelva a entrar
WA_ENFORCE_BANS=true

# Registro de comandos (WhatsApp, consola y Discord). Se imprime siempre; en MariaDB si está activo.
COMMAND_LOG_DB=true
COMMAND_LOG_RETENTION_DAYS=30

# Advertencias (!warn): al llegar a este número se aplica la sanción (0 = desactivado)
WA_WARN_LIMIT=3
# Sanción al llegar al límite: kick (expulsar) o ban (expulsar y bloquear)
WA_WARN_ACTION=kick

# Límites de adjuntos WhatsApp -> Discord
# Máximo para enviar un archivo directo a Discord (10 MB en servidores sin mejoras)
DISCORD_MAX_DIRECT_UPLOAD_MB=10
# Máximo de un video que se descarga para subirlo a Catbox (Catbox admite hasta 200 MB)
RELAY_MAX_MEDIA_MB=100

# Permisos de comandos desde LuckPerms (misma base MySQL que usa la red de Minecraft)
# Ver docs/luckperms.md para crear el usuario de base de datos con los permisos mínimos.
LUCKPERMS_ENABLED=false
LUCKPERMS_DB_HOST=localhost
LUCKPERMS_DB_PORT=3306
LUCKPERMS_DB_NAME=luckperms
LUCKPERMS_DB_USER=impebot
LUCKPERMS_DB_PASSWORD=
LUCKPERMS_TABLE_PREFIX=luckperms_
# Contextos "server" que cuentan para el bot además de los globales (separados por coma)
LUCKPERMS_SERVERS=impebot
# Caché de respaldo por si se pierde un aviso de la red (segundos)
LUCKPERMS_CACHE_SECONDS=60
# Cada cuánto se leen los avisos de luckperms_messenger (ms, 0 = no escuchar)
LUCKPERMS_POLL_MS=1000
# !vincular con el código de /whatsapp link (plugin ImpeGeo). Grupos donde se acepta (JIDs ...@g.us
# separados por coma); vacío = solo por privado. En los demás grupos el código se anula al publicarse.
WA_LINK_GROUPS=
# Códigos incorrectos permitidos por persona y hora
WA_LINK_MAX_FAILURES=5

# Vínculos Discord ↔ Minecraft de DiscordSRV (/discord link). Requiere su backend MySQL
# (Experiment_JdbcAccountLinkBackend). Host y puerto por defecto: los de LuckPerms.
DISCORDSRV_LINKS_ENABLED=false
DISCORDSRV_DB_HOST=
DISCORDSRV_DB_PORT=
DISCORDSRV_DB_NAME=discordsrv
DISCORDSRV_DB_USER=
DISCORDSRV_DB_PASSWORD=
DISCORDSRV_TABLE_PREFIX=discordsrv
